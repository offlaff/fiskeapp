<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/navbar.ejs') %>

    <div class="container mt-5">
      <h2 class="text-center mb-4">Godkjenn Fangst</h2>

      <table class="table table-striped table-bordered">
        <thead class="thead-dark">
          <tr>
            <th>Navn</th>
            <th>Vekt</th>
            <th>Lengde</th>
            <th>Agn</th>
            <th>Dato</th>
            <th>Bilde</th>
            <th>Publiser</th>
            <th>Slett</th>
          </tr>
        </thead>
        <tbody id="publish-table-body"></tbody>
      </table>
    </div>
    <script>
      const site = "<%= site %>";
      function getUnPublishedPins() {
        fetch(`/s/${site}/pins/unpublished`)
          .then((res) => res.json())
          .then((result) => {
            pins = result;
            onGotUnpublishedPins();
          });
      }

      function onGotUnpublishedPins() {
        const tableBody = document.getElementById("publish-table-body");
        tableBody.innerHTML = "";

        pins.forEach((pin) => {
          const editButton = `<a href="/s/${site}/edit/${pin.id}" class="btn btn-warning btn-sm edit-btn" data-id="${pin.id}">Rediger</a>`;
          const imageUrl = getSafeImageUrl(pin.image);
          const row = document.createElement("tr");
          row.innerHTML = `
              <td>${escapeHtml(pin.name)}</td>
              <td>${escapeHtml(pin.weight)}</td>
              <td>${escapeHtml(pin.length)}</td>
              <td>${escapeHtml(pin.bait)}</td>
              <td>${escapeHtml(pin.date)}</td>
              <td>
  ${
    imageUrl
      ? `<a href="${escapeHtml(imageUrl)}" target="_blank" rel="noopener noreferrer">
           <img style="width: 75px; height: 75px; object-fit: contain;" src="${escapeHtml(imageUrl)}">
         </a>`
      : "-"
  }
</td>
              <td >${editButton}</td>
          <td> <button id="deletebtn${
            pin.id
          }" class="btn btn-danger btn-sm">Slett</button></td>

            `;
          tableBody.appendChild(row);
          const deletbtn = document
            .getElementById(`deletebtn${pin.id}`)
            .addEventListener("click", async () => {
              const doublecheck = confirm(
                `Er du sikker du vil slette denne fangsten fra ${pin.name}?`,
              );
              if (doublecheck === true) {
                let response = await fetch(`/s/${site}/pins/${pin.id}`, {
                  method: "DELETE",
                  headers: {
                    "Content-Type": "application/json",
                  },
                });
                if (response.ok) {
                  window.location.reload();
                }
              }
            });
        });
      }
      document.addEventListener("DOMContentLoaded", () => {
        getUnPublishedPins();
      });
    </script>
  </body>
</html>
